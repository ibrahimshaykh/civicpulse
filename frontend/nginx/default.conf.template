# envsubst'd at container start by nginx's own docker-entrypoint scripts
# (nginxinc/nginx-unprivileged auto-runs 20-envsubst-on-templates.sh for any
# *.template found here) -- BACKEND_HOST/BACKEND_PORT are the one runtime
# knob this image needs: same built image in compose ("backend") and in
# Kubernetes (the backend Service's DNS name), never a rebuild (rubric B4).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA: any non-file route falls back to index.html so React Router
    # handles it client-side.
    location / {
        try_files $uri /index.html;
    }
}
