{
  "components": {
    "schemas": {
      "Category": {
        "enum": [
          "water",
          "electricity",
          "sanitation",
          "roads",
          "streetlights",
          "other"
        ],
        "title": "Category",
        "type": "string"
      },
      "ComplaintCreate": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Location",
            "type": "string"
          },
          "reporter_contact": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 3,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporter Contact"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 10,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "location"
        ],
        "title": "ComplaintCreate",
        "type": "object"
      },
      "ComplaintOut": {
        "properties": {
          "ai_summary": {
            "anyOf": [
              {
                "maxLength": 140,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Summary"
          },
          "allowed_transitions": {
            "items": {
              "$ref": "#/components/schemas/Status"
            },
            "title": "Allowed Transitions",
            "type": "array"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "reporter_contact": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporter Contact"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "triage_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Triage Confidence"
          },
          "triage_latency_ms": {
            "title": "Triage Latency Ms",
            "type": "integer"
          },
          "triaged_by": {
            "title": "Triaged By",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "location",
          "reporter_contact",
          "category",
          "priority",
          "status",
          "triaged_by",
          "triage_latency_ms",
          "triage_confidence",
          "created_at",
          "updated_at",
          "allowed_transitions"
        ],
        "title": "ComplaintOut",
        "type": "object"
      },
      "ComplaintPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ComplaintOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "pages": {
            "title": "Pages",
            "type": "integer"
          },
          "total": {
