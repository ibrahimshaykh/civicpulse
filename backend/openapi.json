          },
          "fallback_provider": {
            "title": "Fallback Provider",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "recent": {
            "items": {
              "$ref": "#/components/schemas/TriageOutcomeOut"
            },
            "title": "Recent",
            "type": "array"
          }
        },
        "required": [
          "active_provider",
          "fallback_provider",
          "model",
          "cache_hit_rate",
          "recent"
        ],
        "title": "ProvidersOut",
        "type": "object"
      },
      "StatsOut": {
        "properties": {
          "by_category": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "By Category",
            "type": "object"
          },
          "by_priority": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "By Priority",
            "type": "object"
          },
          "by_status": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "By Status",
            "type": "object"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "by_category",
          "by_priority",
          "by_status",
          "generated_at"
        ],
        "title": "StatsOut",
        "type": "object"
      },
      "Status": {
        "enum": [
          "open",
          "in_progress",
          "resolved",
          "rejected"
        ],
        "title": "Status",
        "type": "string"
      },
      "StatusUpdate": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
